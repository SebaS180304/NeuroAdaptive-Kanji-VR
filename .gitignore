# .gitignore de la raiz del proyecto NeuroAdaptive VR.
#
# NOTA SOBRE UNITY: las reglas de Unity NO van aqui. Viven en
# unity-client/.gitignore, que es la plantilla oficial de GitHub para
# Unity y usa patrones anclados (/[Ll]ibrary/, /[Tt]emp/, etc.) que se
# resuelven relativos a SU propia carpeta. Moverlas aqui las romperia.
# Git aplica los .gitignore por directorio, asi que ambos conviven.

# --- Backend (Python) ---
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
*.pyc
*.pyo

# Secretos / configuracion local. NUNCA commitear.
backend/.env
.env
*.env.local

# --- Research Dashboard (Vite + React + TS, dashboard/) ---
# Se versiona el codigo y package-lock.json; se ignora lo que genera npm, Vite,
# TypeScript, Vitest y Playwright. Sin ancla para cubrir tambien la raiz.
node_modules/
dist/
dist-ssr/
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
# Variables locales de Vite (.env.local, .env.development.local, ...)
.env.*.local

# --- Base de datos ---
# El esquema (schema.sql) y el ERD SI se versionan.
# Lo que se ignora son dumps y datos locales.
*.dump
*.sql.gz
database/data/
database/backups/

# --- Docker ---
docker-compose.override.yml

# --- Datos de investigacion ---
# El EEG crudo y los datos de participantes no van al repositorio:
# son datos personales sensibles y pesan demasiado.
data/raw/
data/eeg/
data/participants/
*.edf
*.bdf
*.fif

# --- OS / editores ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
Claude outputs/

# graphify knowledge graph (rebuilt locally by git hooks)
graphify-out/

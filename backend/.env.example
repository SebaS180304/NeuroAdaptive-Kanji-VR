ENVIRONMENT=development

POSTGRES_USER=neuroadaptive
POSTGRES_PASSWORD=neuroadaptive_dev_password
POSTGRES_DB=neuroadaptive_vr
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Every change to this file: between sessions only, then `docker compose up -d backend` (restart keeps the old values, D-F6-283 (2)).

# EEG rule live (D-F6-263, D-F6-275): current = option (1); nosound = option (2); ica = option (3), falling back to (2) by itself.
EEG_LIVE_RULE=current

# The live monitor's per-channel figures (M1b, D-F6-265), computed by live.py. Display only.
EEG_MONITOR_LIVE=false

# The live monitor's per-epoch indices for the whole session (MI, D-F6-277, D-F6-297 (4)), read by the backend. Display only.
MONITOR_LIVE_INDICES=false
